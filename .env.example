ConnectionStrings__Default=Host=localhost;Port=5432;Database=manuals;Username=postgres;Password=change-me
AzureOpenAI__Endpoint=https://your-resource.openai.azure.com/
AzureOpenAI__ApiKey=replace-with-secret
AzureOpenAI__ChatDeployment=replace-with-chat-deployment
AzureOpenAI__EmbeddingDeployment=replace-with-embedding-deployment
