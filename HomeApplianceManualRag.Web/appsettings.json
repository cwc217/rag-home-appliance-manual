{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": { "Default": "" },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeployment": "",
    "EmbeddingDeployment": "",
    "ApiVersion": "2024-10-21",
    "EmbeddingDimensions": 1536
  },
  "Upload": { "MaxFileSizeBytes": 10485760 },
  "Storage": { "RootPath": "App_Data/uploads" },
  "Retrieval": { "TopK": 5, "ChunkSize": 1200, "ChunkOverlap": 200 },
  "RateLimiting": { "RequestsPerMinute": 30 },
  "Docling": {
    "ServiceUrl": "http://docling:5001",
    "TimeoutSeconds": 300,
    "MaxConcurrentJobs": 1,
    "IncludeImages": true,
    "MaxEmbeddedImageBytes": 5242880,
    "ImagesScale": 2
  },
  "TypeSafe": {
    "Endpoint": "https://api.typesafe.ai",
    "ApiKey": "",
    "Model": "jev-latest",
    "MinimumConfidence": 0.85,
    "MaxStateCharacters": 20000
  },
  "MetadataExtraction": {
    "MaxSourceCharacters": 12000,
    "MinimumConfidence": 0.85
  },
  "SeedAdmin": { "Email": "", "Password": "" },
  "AllowedHosts": "*"
}
