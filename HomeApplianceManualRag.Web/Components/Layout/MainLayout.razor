@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-layout">
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer"
                       UserAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Toggle navigation" })" />
        <MudText Typo="Typo.h6">Home Appliance Manual</MudText>
        <MudSpacer />
        <MudLink Href="https://learn.microsoft.com/aspnet/core/" Target="_blank"
                 Color="Color.Inherit" Underline="Underline.None">About</MudLink>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" OverlayAutoClose="true"
               Class="app-drawer" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="app-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pa-md-6 app-content-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563eb",
            Secondary = "#0f766e",
            Background = "#f8fafc",
            Surface = "#ffffff",
            AppbarBackground = "#1e3a8a"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
