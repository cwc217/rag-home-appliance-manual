<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Home Appliance Manual</a>
    </div>
</div>

<div class="build-label" title="Application build time">Build @BuildTime</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="login">Login</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="register">Register</NavLink></div>
            </NotAuthorized>
            <Authorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="my-documents">My documents</NavLink></div>
                <div class="nav-item px-3">
                    <form method="post" action="/account/logout">
                        <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">Logout</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static string BuildTime
    {
        get
        {
            var assemblyPath = typeof(Program).Assembly.Location;
            if (string.IsNullOrWhiteSpace(assemblyPath))
                return "unknown";

            var timestamp = File.GetLastWriteTimeUtc(assemblyPath);
            return timestamp == DateTime.MinValue
                ? "unknown"
                : timestamp.ToString("yyyy-MM-dd HH:mm 'UTC'");
        }
    }
}
