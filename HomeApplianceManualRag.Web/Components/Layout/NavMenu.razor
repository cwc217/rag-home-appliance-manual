@inject ChatHistoryService History
@inject ChatConversationState ConversationState
@implements IDisposable

<MudNavMenu Class="pa-3 nav-menu">
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-3">Navigation</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Add"
                Class="nav-new-conversation" OnClick="NewConversation">
        New chat
    </MudNavLink>
    <AuthorizeView>
            <NotAuthorized>
                <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
                <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
            </NotAuthorized>
            <Authorized>
                <MudNavLink Href="/my-documents" Icon="@Icons.Material.Filled.Description">My documents</MudNavLink>
                <AuthorizeView Roles="@ApplicationRoles.Admin" Context="adminContext">
                    <MudNavLink Href="/admin/chat-review" Icon="@Icons.Material.Filled.Visibility">Chat review</MudNavLink>
                </AuthorizeView>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Logout" Class="nav-logout">
                        Logout
                    </MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    @if (isAuthenticated)
    {
        <MudDivider Class="my-3" />
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Chat">Conversations</MudNavLink>
        <div class="nav-conversations" aria-label="Conversation rooms">
            @if (!conversationsLoaded)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3">Loading chats…</MudText>
            }
            else if (!string.IsNullOrWhiteSpace(conversationsError))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="px-3">@conversationsError</MudText>
            }
            else if (conversations.Count == 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3">No conversations yet</MudText>
            }
            else
            {
                @foreach (var conversation in conversations.Take(8))
                {
                    <MudNavLink Href="@($"/?conversationId={conversation.Id}")"
                                Icon="@Icons.Material.Filled.Forum"
                                Class="nav-conversation-link">
                        @GetConversationTitle(conversation)
                    </MudNavLink>
                }
            }
        </div>
    }
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3 nav-build-version"
             title="Application build time">
        Build @BuildTime
    </MudText>
</MudNavMenu>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private readonly List<ChatConversation> conversations = [];
    private bool isAuthenticated;
    private bool conversationsLoaded;
    private string? conversationsError;

    [Parameter] public EventCallback OnNavigationRequested { get; set; }

    protected override void OnInitialized()
    {
        ConversationState.Changed += OnConversationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            isAuthenticated = (await AuthenticationStateTask!).User.Identity?.IsAuthenticated == true;
            if (isAuthenticated)
                await LoadConversations();
        }
        catch
        {
            conversationsError = "Conversation history unavailable.";
        }
        finally
        {
            conversationsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task NewConversation()
    {
        await OnNavigationRequested.InvokeAsync();
    }

    private async void OnConversationStateChanged(object? sender, EventArgs args)
    {
        if (!isAuthenticated)
            return;

        await InvokeAsync(async () =>
        {
            await LoadConversations();
            StateHasChanged();
        });
    }

    private async Task LoadConversations()
    {
        conversations.Clear();
        conversations.AddRange(await History.GetConversationsAsync(null));
    }

    public void Dispose()
    {
        ConversationState.Changed -= OnConversationStateChanged;
    }

    private static string GetConversationTitle(ChatConversation conversation) =>
        conversation.Title == "New chat" ? "Current chat" : conversation.Title;

    private static string BuildTime
    {
        get
        {
            var assemblyPath = typeof(Program).Assembly.Location;
            if (string.IsNullOrWhiteSpace(assemblyPath))
                return "unknown";

            var timestamp = File.GetLastWriteTimeUtc(assemblyPath);
            if (timestamp == DateTime.MinValue)
                return "unknown";

            var localTime = new DateTimeOffset(timestamp, TimeSpan.Zero)
                .ToOffset(TimeSpan.FromHours(8));
            return localTime.ToString("yyyy-MM-dd HH:mm 'UTC+8'");
        }
    }
}
