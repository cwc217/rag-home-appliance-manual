@page "/admin/chat-review"
@attribute [Authorize(Policy = ApplicationPolicies.AdminOnly)]
@using HomeApplianceManualRag.Web.Admin
@inject AdminConversationService Conversations
@inject IDialogService DialogService

<PageTitle>Chat review</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudText Typo="Typo.h4">Chat review</MudText>
    <MudText Color="Color.Secondary" Class="mb-4">
        Review the latest 20 authenticated and anonymous conversations.
    </MudText>

    @if (items is null && errorMessage is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (items is { Count: 0 })
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No conversations yet.</MudText>
    }
    else if (items is not null)
    {
        <MudTable T="AdminConversationSummary" Items="@items" Hover="true" Dense="true"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Conversation</MudTh>
                <MudTh>Owner</MudTh>
                <MudTh>Messages</MudTh>
                <MudTh>Updated</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Conversation">
                    <MudText Typo="Typo.body2" Class="text-break">@context.Title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Created @context.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Owner">@context.Owner</MudTd>
                <MudTd DataLabel="Messages">@context.MessageCount</MudTd>
                <MudTd DataLabel="Updated">
                    @context.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="() => ShowConversationAsync(context.Id)">
                        Detail
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private IReadOnlyList<AdminConversationSummary>? items;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Conversations.GetRecentSummariesAsync(20);
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Administrator access is required.";
        }
        catch (Exception)
        {
            errorMessage = "Conversation history unavailable.";
        }
    }

    private async Task ShowConversationAsync(Guid conversationId)
    {
        var detail = await Conversations.GetDetailAsync(conversationId);
        if (detail is null)
            return;

        await DialogService.ShowAsync<AdminConversationDialog>(
            "Conversation detail",
            new DialogParameters { ["Detail"] = detail },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true });
    }
}
