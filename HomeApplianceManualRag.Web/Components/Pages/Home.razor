@page "/"
@rendermode InteractiveServer
@inject ChatService Chat
@using HomeApplianceManualRag.Web.Resources
@using System.Globalization

<PageTitle>Chat Room</PageTitle>
<h1>Chat Room</h1>
<p class="text-muted">Ask a question about your available appliance manuals.</p>

<EditForm Model="form" OnValidSubmit="Ask">
    <div class="input-group mb-3">
        <InputText class="form-control" @bind-Value="form.Question" aria-label="Question" placeholder="How do I clean the filter?" />
        <button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Thinking..." : "Ask")</button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(noContext))
{
    <div class="alert alert-info" role="status">@noContext</div>
}
@if (answer.Length > 0)
{
    <section class="card" aria-live="polite">
        <div class="card-body">
            <p class="mb-3" style="white-space: pre-wrap">@answer</p>
            @if (citations.Count > 0)
            {
                <h2 class="h6">Sources</h2>
                <ul>
                    @foreach (var citation in citations)
                    {
                        <li>@citation.Label</li>
                    }
                </ul>
            }
        </div>
    </section>
}

@code {
    private string answer = string.Empty;
    private string? error;
    private string? noContext;
    private bool busy;
    private readonly List<ChatCitation> citations = [];
    private readonly ChatForm form = new();

    private async Task Ask()
    {
        if (busy) return;
        busy = true;
        answer = string.Empty;
        error = null;
        noContext = null;
        citations.Clear();
        try
        {
            var result = await Chat.StartAsync(form.Question);
            citations.AddRange(result.Response.Citations);
            if (!result.Response.HasContext)
            {
                noContext = ChatMessages.NoContext(CultureInfo.CurrentUICulture.Name);
                return;
            }
            await foreach (var token in result.Stream!)
            {
                answer += token;
                await InvokeAsync(StateHasChanged);
            }

        }
        catch (ChatRateLimitException ex)
        {
            error = ChatMessages.RateLimited(CultureInfo.CurrentUICulture.Name,
                Math.Max(1, (int)Math.Ceiling(ex.RetryAfter.TotalSeconds)));
        }
        catch (ChatProviderException)
        {
            error = "The answer service is temporarily unavailable. Please try again.";
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ChatForm
    {
        public string Question { get; set; } = string.Empty;
    }
}
