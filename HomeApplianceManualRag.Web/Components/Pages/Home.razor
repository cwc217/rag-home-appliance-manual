@page "/"
@rendermode InteractiveServer
@inject ChatService Chat
@inject ChatHistoryService History
@using HomeApplianceManualRag.Web.Data
@using HomeApplianceManualRag.Web.Resources
@using System.Globalization

<PageTitle>Chat Room</PageTitle>
<main class="chat-shell">
    <section class="chat-transcript" aria-label="Conversation" aria-live="polite">
        @if (loadingHistory)
        {
            <MudText Class="chat-state" Color="Color.Secondary">Loading conversation history…</MudText>
        }
        else if (messages.Count == 0)
        {
            <MudText Class="chat-state" Color="Color.Secondary">
                Ask a question and get an answer grounded in your available manuals.
            </MudText>
        }
        @foreach (var message in messages)
        {
            <article class="chat-message @(message.Role == ChatMessageRole.User ? "chat-message-user" : "chat-message-assistant")">
                <MudText Class="sr-only">@(message.Role == ChatMessageRole.User ? "You" : "Assistant")</MudText>
                <MudPaper Class="chat-bubble pa-3" Elevation="1">@message.Content</MudPaper>
                @if (message.Citations.Count > 0)
                {
                    <div class="chat-citations">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Sources</MudText>
                        <ul>
                            @foreach (var citation in message.Citations)
                            {
                                <li>@citation.Label</li>
                            }
                        </ul>
                    </div>
                }
            </article>
        }
        @if (busy)
        {
            <MudText Class="chat-state" Color="Color.Secondary">Thinking…</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error">@error</MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(noContext))
        {
            <MudAlert Severity="Severity.Info">@noContext</MudAlert>
        }
    </section>

    <EditForm Model="form" OnValidSubmit="Ask" class="chat-composer">
        <MudTextField T="string" @bind-Value="form.Question" Label="Question" Variant="Variant.Outlined"
                      Placeholder="How do I clean the filter?" Lines="2" Disabled="@busy"
                      FullWidth="true" />
        <div class="composer-actions">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Use the manual wording when possible.</MudText>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(busy || string.IsNullOrWhiteSpace(form.Question))">
                @if (busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Thinking…</span>
                }
                else
                {
                    <span>Ask</span>
                }
            </MudButton>
        </div>
    </EditForm>
</main>

@code {
    private readonly ChatForm form = new();
    private readonly List<UiMessage> messages = [];
    private string? error;
    private string? noContext;
    private bool busy;
    private bool loadingHistory = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            foreach (var message in await History.GetHistoryAsync())
                messages.Add(new UiMessage(message.Role, message.Content, message.Citations));
        }
        catch
        {
            error = "Conversation history is temporarily unavailable.";
        }
        finally
        {
            loadingHistory = false;
        }
    }

    private async Task Ask()
    {
        if (busy || string.IsNullOrWhiteSpace(form.Question)) return;
        busy = true;
        error = null;
        noContext = null;
        var question = form.Question.Trim();
        messages.Add(new UiMessage(ChatMessageRole.User, question, []));
        form.Question = string.Empty;
        try
        {
            var result = await Chat.StartAsync(question);
            if (!result.Response.HasContext)
            {
                noContext = ChatMessages.NoContext(CultureInfo.CurrentUICulture.Name);
                messages.Add(new UiMessage(ChatMessageRole.Assistant, noContext, result.Response.Citations));
                await History.PersistExchangeAsync(question, noContext, result.Response.Citations);
                return;
            }

            var assistant = new UiMessage(ChatMessageRole.Assistant, string.Empty, result.Response.Citations);
            messages.Add(assistant);
            await foreach (var token in result.Stream!)
            {
                assistant.Content += token;
                await InvokeAsync(StateHasChanged);
            }
            await History.PersistExchangeAsync(question, assistant.Content, assistant.Citations);
        }
        catch (ChatRateLimitException ex)
        {
            messages.RemoveAt(messages.Count - 1);
            error = ChatMessages.RateLimited(CultureInfo.CurrentUICulture.Name,
                Math.Max(1, (int)Math.Ceiling(ex.RetryAfter.TotalSeconds)));
        }
        catch (ChatProviderException)
        {
            messages.RemoveAt(messages.Count - 1);
            error = "The answer service is temporarily unavailable. Please try again.";
        }
        catch (ArgumentException ex)
        {
            messages.RemoveAt(messages.Count - 1);
            error = ex.Message;
        }
        catch
        {
            error = "Your answer was generated, but it could not be saved. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ChatForm { public string Question { get; set; } = string.Empty; }
    private sealed class UiMessage(ChatMessageRole role, string content, IReadOnlyList<ChatCitation> citations)
    {
        public ChatMessageRole Role { get; } = role;
        public string Content { get; set; } = content;
        public IReadOnlyList<ChatCitation> Citations { get; } = citations;
    }
}
