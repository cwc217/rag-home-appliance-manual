@page "/admin/documents"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ApplicationPolicies.AdminOnly)]
@inject DocumentService Documents
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Admin documents</PageTitle>
<h1>Admin documents</h1>
<p>PDF only, maximum 10 MB. Admin uploads are public when Ready.</p>
<InputFile OnChange="Upload" accept=".pdf,application/pdf" />
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
<ul>
@foreach (var document in documents)
{
    <li><strong>@document.DisplayName</strong> — @document.Status
        @if (document.Status == DocumentStatus.Failed) { <button @onclick="() => Retry(document.Id)">Retry</button> }
        <button @onclick="() => Reindex(document.Id)">Re-index</button>
        <button @onclick="() => Delete(document.Id)">Delete</button>
        @if (!string.IsNullOrWhiteSpace(document.LastError)) { <span class="text-danger">@document.LastError</span> }
    </li>
}
</ul>
@code {
    private List<ManualDocument> documents = [];
    private string? error;
    protected override async Task OnInitializedAsync() => await Refresh();
    private async Task Refresh() => documents = await Documents.ListAsync(true);
    private async Task Upload(InputFileChangeEventArgs e) { try { await Documents.UploadAsync(e.File); error = null; await Refresh(); } catch (InvalidDataException ex) { error = ex.Message; } }
    private async Task Retry(Guid id) { try { await Documents.RetryAsync(id, true); await Refresh(); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { error = ex.Message; } }
    private async Task Reindex(Guid id) { try { await Documents.ReindexAsync(id); await Refresh(); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { error = ex.Message; } }
    private async Task Delete(Guid id) { try { await Documents.DeleteAsync(id); await Refresh(); } catch (UnauthorizedAccessException ex) { error = ex.Message; } }
}
