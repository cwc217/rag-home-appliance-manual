@page "/my-documents"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ApplicationPolicies.RegisteredUser)]
@inject DocumentService Documents
@inject ICurrentUser CurrentUser
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<PageTitle>@(isAdmin ? "All documents" : "My documents")</PageTitle>
<h1>@(isAdmin ? "All documents" : "My documents")</h1>
<p>PDF only, maximum 10 MB. @(isAdmin ? "Administrators have unlimited uploads." : $"Active quota: {activeCount} / 3.")</p>
<form method="post" action="/documents/upload" enctype="multipart/form-data" class="mb-3">
    <AntiforgeryToken />
    <input type="file" name="file" accept=".pdf,application/pdf" />
    <button type="submit" class="btn btn-primary ms-2">Upload</button>
</form>
@if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
<div class="row g-3">
@foreach (var document in documents)
{
    <div class="col-12 col-md-6 col-xl-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title text-break">@document.DisplayName</h2>
                <p class="card-text mb-2">Status: <strong>@GetStage(document)</strong></p>
                @if (!refreshStopped && IsProcessing(document))
                {
                    <div class="progress mb-3" role="progressbar" aria-label="@GetStage(document)">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @GetProgressWidth(document.Status)%"></div>
                    </div>
                    <div class="d-flex align-items-center gap-2 small text-muted mb-2">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Indexing in progress. This page updates automatically.</span>
                    </div>
                }
                @if (isAdmin) { <p class="card-text small text-muted">Owner: @(document.OwnerEmail ?? "Admin/public")</p> }
                @if (!string.IsNullOrWhiteSpace(document.LastError)) { <p class="card-text text-danger">@document.LastError</p> }
                <div class="mt-auto d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-primary btn-sm" href="/documents/@document.Id/download">Download</a>
                    @if (IsFailed(document)) { <button class="btn btn-outline-secondary btn-sm" @onclick="() => Retry(document.Id)">Retry</button> }
                    @if (isAdmin) { <button class="btn btn-outline-secondary btn-sm" @onclick="() => Reindex(document.Id)">Re-index</button> }
                    <form method="post" action="/documents/@document.Id/delete" class="d-inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    private List<ManualDocument> documents = [];
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private bool refreshStopped;
    [SupplyParameterFromQuery(Name = "error")]
    private string? errorMessage { get; set; }
    private bool isAdmin => CurrentUser.IsInRole(ApplicationRoles.Admin);
    private int activeCount => documents.Count(IsActive);
    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        StartRefreshLoop();
    }
    private async Task Refresh() => documents = await Documents.ListAsync();
    private async Task Retry(Guid id) { try { await Documents.RetryAsync(id); refreshStopped = false; await Refresh(); StartRefreshLoop(); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { refreshStopped = true; errorMessage = ex.Message; } }
    private async Task Reindex(Guid id) { try { await Documents.ReindexAsync(id); refreshStopped = false; await Refresh(); StartRefreshLoop(); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { refreshStopped = true; errorMessage = ex.Message; } }
    private void StartRefreshLoop()
    {
        if (documents.Any(IsProcessing) &&
            (refreshTask is null || refreshTask.IsCompleted))
            refreshTask = RefreshWhileProcessingAsync(refreshCancellation.Token);
    }
    private async Task RefreshWhileProcessingAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        while (await timer.WaitForNextTickAsync(ct))
        {
            if (!documents.Any(IsProcessing))
                break;
            try
            {
                await InvokeAsync(async () =>
                {
                    await RefreshProgressAsync();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                break;
            }
            catch (Exception)
            {
                refreshStopped = true;
                errorMessage = "Unable to refresh document status. Please reload the page.";
                await InvokeAsync(StateHasChanged);
                break;
            }
        }
    }

        private async Task RefreshProgressAsync()
        {
            var progressIds = documents
                .Where(IsProcessing)
                .Select(x => x.Id)
                .ToArray();
            if (progressIds.Length == 0)
                return;

            var updates = await Documents.ListProgressAsync(progressIds);
            var updatesById = updates.ToDictionary(x => x.Id);
            for (var index = 0; index < documents.Count; index++)
            {
                if (updatesById.TryGetValue(documents[index].Id, out var update))
                    documents[index] = update;
            }
        }
    private static bool HasError(ManualDocument document) => !string.IsNullOrWhiteSpace(document.LastError);
    private static bool IsProcessing(ManualDocument document) =>
        !HasError(document) && (document.Status is DocumentStatus.Pending or DocumentStatus.Processing);
    private static bool IsFailed(ManualDocument document) =>
        document.Status == DocumentStatus.Failed || HasError(document);
    private static bool IsActive(ManualDocument document) =>
        !HasError(document) && (document.Status is DocumentStatus.Pending or DocumentStatus.Processing or DocumentStatus.Ready);
    private static string GetStage(ManualDocument document)
    {
        if (HasError(document))
            return "Failed";
        return document.Status switch
        {
            DocumentStatus.Pending => "Queued",
            DocumentStatus.Processing => "Processing",
            DocumentStatus.Ready => "Ready",
            DocumentStatus.Failed => "Failed",
            _ => document.Status.ToString()
        };
    }
    private static int GetProgressWidth(DocumentStatus status) => status == DocumentStatus.Processing ? 66 : 33;
    public async ValueTask DisposeAsync()
    {
        refreshCancellation.Cancel();
        if (refreshTask is not null)
        {
            try { await refreshTask; } catch (OperationCanceledException) { }
        }
        refreshCancellation.Dispose();
    }
}
