@page "/my-documents"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ApplicationPolicies.RegisteredUser)]
@inject DocumentService Documents
@inject ICurrentUser CurrentUser
@inject DocumentProgressNotifier ProgressNotifier
@inject IDialogService DialogService
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using HomeApplianceManualRag.Web.Documents
@using HomeApplianceManualRag.Web.Localization
@implements IAsyncDisposable

<PageTitle>@(isAdmin ? L["All documents"] : L["My documents"])</PageTitle>
<MudStack Spacing="3">
<MudText Typo="Typo.h4">@(isAdmin ? L["All documents"] : L["My documents"])</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary">
    @(isAdmin ? L["Administrators have unlimited uploads."] : L["Active quota: {0} / 3.", activeCount])
</MudText>
<MudPaper Class="pa-4" Elevation="1">
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="document-upload">
    <div class="document-file-field">
        <label for="manual-upload">@L["PDF manual"]</label>
        <InputFile id="manual-upload" OnChange="SelectFile" accept=".pdf,application/pdf"
                   aria-describedby="manual-upload-help" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload"
               OnClick="Upload" Disabled="@(selectedFile is null || IsUploadDisabled)">@L["Upload"]</MudButton>
    @if (busy)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(uploadProgressPercent is int percent
                ? percent == 100 ? L["Finishing upload…"] : L["Uploading PDF: {0}%", percent]
                : L["Validating PDF and preparing upload…"])
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                   OnClick="ConfirmCancelUpload">@L["Cancel"]</MudButton>
    }
</MudStack>
@if (uploadProgressPercent is int uploadPercent)
{
    <MudProgressLinear Value="@((double)uploadPercent)" Color="Color.Primary" Class="mt-2" />
}
<MudAlert Severity="Severity.Info" Dense="true" Class="document-upload-tips">
    <MudText Typo="Typo.subtitle2">@L["Upload guidelines"]</MudText>
    <ul>
        <li>@L["Upload a single PDF file (Max 10 MB)."]</li>
        <li>@L["Upload the manual for one appliance. Include its brand and exact model number in the PDF or file name."]</li>
        <li>@L["Use a clear, text-searchable PDF. Scanned or blurry pages and password-protected files may not be read accurately."]</li>
        <li>@L["Use one language per PDF."]</li>
    </ul>
</MudAlert>
</MudPaper>
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="document-error">@errorMessage</MudAlert>
}
<MudGrid Spacing="3">
@foreach (var document in documents)
{
    <MudItem xs="12" md="6" xl="4">
        <MudCard Class="h-100 document-card">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="text-break">@document.DisplayName</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    @L["Status"]:
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(document)">
                        @(document.DeletedAtUtc is null ? L[GetStage(document)] : L["Deleted"])
                    </MudChip>
                </MudText>
                @if (ManualDocumentPresentation.FormatProductSummary(document) is string productSummary)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2 text-break">
                        @productSummary
                    </MudText>
                }
                @if (document.DeletedAtUtc is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        @L["Deleted {0}", FormatDate(document.DeletedAtUtc.Value)]
                    </MudAlert>
                }
                @if (!refreshStopped && IsProcessing(document))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["{0}. This page updates automatically.", GetProgressLabel(document)]
                        </MudText>
                    </MudStack>
                    @if (TryGetEmbeddingProgress(document, out var embeddingProgress))
                    {
                        <MudProgressLinear Value="@embeddingProgress" Color="Color.Primary" Class="mb-3" />
                    }
                }
                @if (isAdmin) { <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Owner"]: @(document.OwnerEmail ?? L["Admin/public"].Value)</MudText> }
                @if (!string.IsNullOrWhiteSpace(document.LastError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2 document-error">
                        <MudText Class="document-error-message">
                            @L[IndexingErrorMessages.ForDisplay(document.LastError)!]
                        </MudText>
                    </MudAlert>
                }
            </MudCardContent>
            <MudCardActions Class="mt-auto">
                @if (document.DeletedAtUtc is null)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="@($"/documents/{document.Id}/download")">@L["Download"]</MudButton>
                    @if (document.Status is DocumentStatus.Failed or DocumentStatus.Cancelled) { <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => Retry(document.Id)" Disabled="@IsBusy(document.Id)">@L["Retry"]</MudButton> }
                    @if (IsProcessingStatus(document))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   OnClick="() => ConfirmCancelProcessing(document)"
                                   Disabled="@IsBusy(document.Id)">@L["Cancel"]</MudButton>
                    }
                    @if (isAdmin) { <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => Reindex(document.Id)" Disabled="@IsDocumentActionDisabled(document)">@L["Re-index"]</MudButton> }
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => ConfirmDelete(document)" Disabled="@IsDocumentActionDisabled(document)">@L["Delete"]</MudButton>
                }
                else if (isAdmin)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => Restore(document.Id)" Disabled="@IsBusy(document.Id)">@L["Restore"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => ConfirmHardDelete(document)" Disabled="@(IsBusy(document.Id) || IsProcessingStatus(document))">@L["Permanently delete"]</MudButton>
                }
            </MudCardActions>
        </MudCard>
    </MudItem>
}
</MudGrid>
</MudStack>

@code {
    private List<ManualDocument> documents = [];
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private IDisposable? progressSubscription;
    private readonly HashSet<Guid> busyDocuments = [];
    private IBrowserFile? selectedFile;
    private CancellationTokenSource? uploadCancellation;
    private Guid? uploadedDocumentId;
    private bool busy;
    private int? uploadProgressPercent;
    private bool refreshStopped;
    private CultureInfo uiCulture = CultureInfo.CurrentUICulture;
    [SupplyParameterFromQuery(Name = "error")]
    private string? errorMessage { get; set; }
    private bool isAdmin => CurrentUser.IsInRole(ApplicationRoles.Admin);
    private int activeCount => documents.Count(IsActive);
    protected override async Task OnInitializedAsync()
    {
        uiCulture = CultureInfo.CurrentUICulture;
        progressSubscription = ProgressNotifier.Subscribe(
            CurrentUser.UserId,
            isAdmin,
            HandleProgressAsync);
        await Refresh();
        StartFallbackRefresh();
    }
    private async Task Refresh() => documents = await Documents.ListAsync();
    private void SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        errorMessage = null;
    }
    private async Task Upload()
    {
        if (selectedFile is null || busy)
            return;

        busy = true;
        uploadCancellation = new CancellationTokenSource();
        uploadedDocumentId = null;
        uploadProgressPercent = null;
        errorMessage = null;
        try
        {
            var file = selectedFile;
            var progress = new Progress<long>(bytesRead =>
            {
                if (!busy)
                    return;
                var percent = (int)Math.Clamp(bytesRead * 100d / file.Size, 0, 100);
                if (uploadProgressPercent == percent)
                    return;
                uploadProgressPercent = percent;
                StateHasChanged();
            });
            var document = await Documents.UploadAsync(
                file,
                uploadCancellation.Token,
                progress);
            uploadedDocumentId = document.Id;
            uploadCancellation.Dispose();
            uploadCancellation = null;
            selectedFile = null;
            refreshStopped = false;
            await Refresh();
            StartFallbackRefresh();
        }
        catch (Exception ex) when (ex is InvalidDataException or DocumentQuotaExceededException or DocumentProcessingInProgressException or UnauthorizedAccessException or IOException)
        {
            errorMessage = L[ex.Message].Value;
        }
        catch (OperationCanceledException) when (uploadCancellation?.IsCancellationRequested == true)
        {
            errorMessage = L["Upload cancelled."];
        }
        finally
        {
            busy = false;
            uploadProgressPercent = null;
            uploadCancellation?.Dispose();
            uploadCancellation = null;
        }
    }
    private async Task ConfirmCancelUpload()
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Cancel upload?"],
            L["The upload or indexing process will continue unless you confirm."],
            yesText: L["Cancel upload"],
            cancelText: L["Continue"],
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed != true)
            return;

        if (busy && uploadCancellation is not null)
        {
            uploadCancellation.Cancel();
            return;
        }

        if (uploadedDocumentId is Guid documentId)
            await ConfirmCancelProcessingById(documentId);
    }
    private async Task ConfirmCancelProcessing(ManualDocument document)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Cancel processing?"],
            L["Cancel indexing for \"{0}\"? The uploaded PDF will be kept and can be retried.", document.DisplayName],
            yesText: L["Cancel processing"],
            cancelText: L["Continue processing"],
            options: new DialogOptions { CloseOnEscapeKey = true });
        if (confirmed == true)
            await ConfirmCancelProcessingById(document.Id);
    }
    private async Task ConfirmCancelProcessingById(Guid documentId)
    {
        if (!busyDocuments.Add(documentId))
            return;

        errorMessage = null;
        try
        {
            var cancelled = await Documents.CancelProcessingAsync(documentId);
            if (!cancelled)
                errorMessage = L["Processing has already finished and cannot be cancelled."];
            await Refresh();
            refreshStopped = false;
            StartFallbackRefresh();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or KeyNotFoundException or IOException)
        {
            errorMessage = L[ex.Message].Value;
        }
        finally
        {
            busyDocuments.Remove(documentId);
        }
    }
    private async Task Retry(Guid id)
    {
        await RunDocumentAction(id, () => Documents.RetryAsync(id));
    }
    private async Task Reindex(Guid id)
    {
        await RunDocumentAction(id, () => Documents.ReindexAsync(id));
    }
    private async Task Restore(Guid id)
    {
        await RunDocumentAction(id, () => Documents.RestoreAsync(id));
    }
    private async Task ConfirmDelete(ManualDocument document)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Delete document?"],
            L["Delete \"{0}\"? This action cannot be undone.", document.DisplayName],
            yesText: L["Delete"],
            cancelText: L["Cancel"],
            options: new DialogOptions { CloseOnEscapeKey = true });

        if (confirmed == true)
            await RunDocumentAction(document.Id, () => Documents.DeleteAsync(document.Id));
    }
    private async Task ConfirmHardDelete(ManualDocument document)
    {
        var confirmed = await DialogService.ShowMessageBox(
            L["Permanently delete document?"],
            L["Permanently delete \"{0}\" and its stored PDF? This cannot be undone.", document.DisplayName],
            yesText: L["Permanently delete"],
            cancelText: L["Cancel"],
            options: new DialogOptions { CloseOnEscapeKey = true });

        if (confirmed == true)
            await RunDocumentAction(document.Id, () => Documents.HardDeleteAsync(document.Id));
    }
    private async Task RunDocumentAction(Guid id, Func<Task> action)
    {
        if (!busyDocuments.Add(id))
            return;

        errorMessage = null;
        try
        {
            await action();
            documents.RemoveAll(x => x.Id == id);
            refreshStopped = false;
            await Refresh();
            StartFallbackRefresh();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException or KeyNotFoundException or FileNotFoundException or IOException)
        {
            refreshStopped = true;
            errorMessage = L[ex.Message].Value;
        }
        finally
        {
            busyDocuments.Remove(id);
        }
    }
    private bool IsBusy(Guid id) => busy || busyDocuments.Contains(id);
    private bool IsUploadDisabled => busy || documents.Any(IsProcessing);
    private bool IsDocumentActionDisabled(ManualDocument document) =>
        IsBusy(document.Id) || IsProcessing(document);
    private void StartFallbackRefresh()
    {
        if (documents.Any(IsProcessing) &&
            (refreshTask is null || refreshTask.IsCompleted))
            refreshTask = FallbackRefreshAsync(refreshCancellation.Token);
    }
    private async Task FallbackRefreshAsync(CancellationToken ct)
    {
        await UiCultureExecution.RunAsync(uiCulture, () => RunFallbackRefreshAsync(ct));
    }
    private async Task RunFallbackRefreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        while (await timer.WaitForNextTickAsync(ct))
        {
            if (!documents.Any(IsProcessing))
                break;
            try
            {
                await InvokeAsync(async () =>
                {
                    await RefreshProgressAsync();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                break;
            }
            catch (Exception)
            {
                refreshStopped = true;
                errorMessage = L["Unable to refresh document status. Please reload the page."];
                await InvokeAsync(StateHasChanged);
                break;
            }
        }
    }
    private async Task HandleProgressAsync(DocumentProgressUpdate update)
    {
        try
        {
            await UiCultureExecution.RunAsync(uiCulture, () => InvokeAsync(async () =>
            {
                if (update.Status == DocumentStatus.Ready)
                {
                    await Refresh();
                    refreshStopped = false;
                    StateHasChanged();
                    return;
                }

                var document = documents.FirstOrDefault(x => x.Id == update.DocumentId);
                if (document is null)
                {
                    try
                    {
                        document = (await Documents.ListProgressAsync([update.DocumentId])).SingleOrDefault();
                    }
                    catch (DocumentForbiddenException)
                    {
                        return;
                    }

                    if (document is null)
                        return;
                    documents.Add(document);
                }
                document.Status = update.Status;
                document.LastError = update.LastError;
                document.ProcessingStage = update.Stage;
                document.ProgressCompletedUnits = update.CompletedUnits;
                document.ProgressTotalUnits = update.TotalUnits;
                document.UpdatedAtUtc = DateTime.UtcNow;
                refreshStopped = false;
                StateHasChanged();
            }));
        }
        catch (DocumentForbiddenException)
        {
            progressSubscription?.Dispose();
            progressSubscription = null;
        }
        catch (InvalidOperationException) when (refreshCancellation.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshProgressAsync()
        {
            var progressIds = documents
                .Where(IsProcessing)
                .Select(x => x.Id)
                .ToArray();
            if (progressIds.Length == 0)
                return;

            var updates = await Documents.ListProgressAsync(progressIds);
            var updatesById = updates.ToDictionary(x => x.Id);
            for (var index = 0; index < documents.Count; index++)
            {
                if (updatesById.TryGetValue(documents[index].Id, out var update))
                    documents[index] = update;
            }
        }
    private static bool HasError(ManualDocument document) => !string.IsNullOrWhiteSpace(document.LastError);
    private static bool IsProcessing(ManualDocument document) =>
        document.DeletedAtUtc is null &&
        !HasError(document) && (document.Status is DocumentStatus.Pending or DocumentStatus.Processing);
    private static bool IsProcessingStatus(ManualDocument document) =>
        document.Status is DocumentStatus.Pending or DocumentStatus.Processing;
    private static bool IsFailed(ManualDocument document) =>
        document.Status is DocumentStatus.Failed or DocumentStatus.Rejected || HasError(document);
    private static bool IsActive(ManualDocument document) =>
        document.DeletedAtUtc is null &&
        !HasError(document) && (document.Status is DocumentStatus.Pending or DocumentStatus.Processing or DocumentStatus.Ready);
    private static string GetStage(ManualDocument document)
    {
        if (HasError(document))
            return document.Status == DocumentStatus.Rejected ? "Rejected" : "Failed";
        return document.Status switch
        {
            DocumentStatus.Pending => "Queued",
            DocumentStatus.Processing => "Processing",
            DocumentStatus.Ready => "Ready",
            DocumentStatus.Failed => "Failed",
            _ => document.Status.ToString()
        };
    }
    private string GetProgressLabel(ManualDocument document) =>
        $"{GetProgressStageNumber(document.ProcessingStage)}/8 · {L[GetProgressStageName(document.ProcessingStage)]}" +
        (document.ProcessingStage == DocumentProcessingStage.CreatingEmbeddings &&
         document.ProgressCompletedUnits is int completed &&
         document.ProgressTotalUnits is int total
            ? $" {L["({0}/{1} chunks)", completed, total]}"
            : string.Empty);
    private static int GetProgressStageNumber(DocumentProcessingStage stage) => stage switch
    {
        DocumentProcessingStage.Queued => 1,
        DocumentProcessingStage.ExtractingText => 2,
        DocumentProcessingStage.VerifyingManual => 3,
        DocumentProcessingStage.AnalyzingImages => 4,
        DocumentProcessingStage.ExtractingMetadata => 5,
        DocumentProcessingStage.PreparingChunks => 6,
        DocumentProcessingStage.CreatingEmbeddings => 7,
        _ => 8
    };
    private static string GetProgressStageName(DocumentProcessingStage stage) => stage switch
    {
        DocumentProcessingStage.Queued => "Waiting in queue",
        DocumentProcessingStage.ExtractingText => "Extracting PDF text",
        DocumentProcessingStage.VerifyingManual => "Checking the manual",
        DocumentProcessingStage.AnalyzingImages => "Analyzing diagrams, if present",
        DocumentProcessingStage.ExtractingMetadata => "Identifying appliance details",
        DocumentProcessingStage.PreparingChunks => "Preparing searchable sections",
        DocumentProcessingStage.CreatingEmbeddings => "Building search index",
        DocumentProcessingStage.SavingIndex => "Saving search index",
        _ => "Finishing"
    };
    private static bool TryGetEmbeddingProgress(ManualDocument document, out double value)
    {
        if (document.ProcessingStage == DocumentProcessingStage.CreatingEmbeddings &&
            document.ProgressCompletedUnits is int completed &&
            document.ProgressTotalUnits is int total &&
            total > 0)
        {
            value = Math.Clamp(completed * 100d / total, 0, 100);
            return true;
        }
        value = 0;
        return false;
    }
    private static Color GetStatusColor(ManualDocument document) =>
        document.DeletedAtUtc is not null ? Color.Dark :
        IsFailed(document) ? Color.Error : document.Status switch
        {
            DocumentStatus.Ready => Color.Success,
            DocumentStatus.Processing => Color.Info,
            _ => Color.Warning
        };
    private static string FormatDate(DateTime value) =>
        DateTimeDisplay.FormatUtcPlusEight(value);
    public async ValueTask DisposeAsync()
    {
        progressSubscription?.Dispose();
        uploadCancellation?.Cancel();
        uploadCancellation?.Dispose();
        refreshCancellation.Cancel();
        if (refreshTask is not null)
        {
            try { await refreshTask; } catch (OperationCanceledException) { }
        }
        refreshCancellation.Dispose();
    }
}
