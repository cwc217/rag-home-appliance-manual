@page "/my-documents"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ApplicationPolicies.RegisteredUser)]
@inject DocumentService Documents
@inject ICurrentUser CurrentUser
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(isAdmin ? "All documents" : "My documents")</PageTitle>
<h1>@(isAdmin ? "All documents" : "My documents")</h1>
<p>PDF only, maximum 10 MB. @(isAdmin ? "Administrators have unlimited uploads." : $"Active quota: {activeCount} / 3.")</p>
<div class="mb-3">
    <InputFile OnChange="SelectFile" accept=".pdf,application/pdf" disabled="@isUploading" />
    <div class="mt-2">
        <span>@(selectedFile?.Name ?? "No file selected")</span>
        <button type="button" class="btn btn-primary ms-2" @onclick="Upload" disabled="@isUploading">
            @(isUploading ? "Uploading..." : "Upload")
        </button>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger" role="alert">@error</div> }
<ul>
@foreach (var document in documents)
{
    <li><strong>@document.DisplayName</strong> — @document.Status
        @if (isAdmin) { <span> — Owner: @(document.OwnerUserId ?? "Admin/public")</span> }
        @if (document.Status == DocumentStatus.Failed) { <button @onclick="() => Retry(document.Id)">Retry</button> }
        <button @onclick="() => Delete(document.Id)">Delete</button>
        @if (isAdmin) { <button @onclick="() => Reindex(document.Id)">Re-index</button> }
        @if (!string.IsNullOrWhiteSpace(document.LastError)) { <span class="text-danger">@document.LastError</span> }
    </li>
}
</ul>

@code {
    private List<ManualDocument> documents = [];
    private string? error;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private bool isAdmin => CurrentUser.IsInRole(ApplicationRoles.Admin);
    private int activeCount => documents.Count(x => x.Status is DocumentStatus.Pending or DocumentStatus.Processing or DocumentStatus.Ready);
    protected override async Task OnInitializedAsync() => await Refresh();
    private async Task Refresh() => documents = await Documents.ListAsync();
    private void SelectFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        error = null;
    }
    private async Task Upload()
    {
        if (isUploading) return;
        if (selectedFile is null)
        {
            error = "Select a PDF file before uploading.";
            return;
        }

        isUploading = true;
        error = null;
        try
        {
            await Documents.UploadAsync(selectedFile);
            selectedFile = null;
            await Refresh();
        }
        catch (Exception ex) when (ex is InvalidDataException or DocumentQuotaExceededException)
        {
            error = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }
    private async Task Retry(Guid id) { try { await Documents.RetryAsync(id); await Refresh(); } catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { error = ex.Message; } }
    private async Task Reindex(Guid id) { try { await Documents.ReindexAsync(id); await Refresh(); } catch (UnauthorizedAccessException ex) { error = ex.Message; } }
    private async Task Delete(Guid id) { try { await Documents.DeleteAsync(id); await Refresh(); } catch (UnauthorizedAccessException ex) { error = ex.Message; } }
}
