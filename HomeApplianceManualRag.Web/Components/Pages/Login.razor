@page "/login"
@using HomeApplianceManualRag.Web.Resources
@inject NavigationManager Navigation
<PageTitle>Login</PageTitle>
<h1>Login</h1>
<form method="post" action="/account/login">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div class="mb-3"><label for="email">Email</label><input id="email" name="email" type="email" required class="form-control" /></div>
    <div class="mb-3"><label for="password">Password</label><input id="password" name="password" type="password" required class="form-control" /></div>
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="text-danger" role="alert">@Error</div> }
    <button class="btn btn-primary" type="submit">Login</button>
</form>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
